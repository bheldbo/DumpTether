# Copy to .env for local Docker Compose use.
# Do not commit real production secrets.

POSTGRES_DB=dumptether
POSTGRES_USER=dumptether
POSTGRES_PASSWORD=change-me-for-local-dev

DUMPTETHER_API_PORT=55868
DUMPTETHER_API_IMAGE=dumptether-api:local
DUMPTETHER_APPLY_MIGRATIONS_ON_STARTUP=false
DUMPTETHER_REQUIRE_AUTHENTICATION=true
DUMPTETHER_ALLOW_GUEST_SESSIONS=true
DUMPTETHER_ENABLE_DEVELOPMENT_LOGIN=true
DUMPTETHER_DEVELOPMENT_EMAIL=dev@dumptether.local
DUMPTETHER_DEVELOPMENT_PASSWORD=dumptether-dev-password
DUMPTETHER_DEVELOPMENT_DISPLAY_NAME=Dev User
DUMPTETHER_MAX_ACTIVE_TASKS_PER_WORKSPACE=1000
DUMPTETHER_MAX_TOTAL_TASKS_PER_WORKSPACE=5000
ASPNETCORE_ENVIRONMENT=Development
