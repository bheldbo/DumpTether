# Copy to .env.prod on the server and replace every placeholder.
# Never commit the real production .env file.

POSTGRES_DB=dumptether
POSTGRES_USER=dumptether
POSTGRES_PASSWORD=replace-with-a-long-random-password

DUMPTETHER_API_IMAGE=ghcr.io/bheldbo/dumptether-api:latest
DUMPTETHER_DATABASE_PROVIDER=Postgres
DUMPTETHER_APPLY_MIGRATIONS_ON_STARTUP=false
DUMPTETHER_REQUIRE_AUTHENTICATION=true
DUMPTETHER_ALLOW_GUEST_SESSIONS=false
DUMPTETHER_SIGNUP_MODE=InviteOnly
DUMPTETHER_SIGNUP_WHITELIST_EMAIL_0=owner@example.com
DUMPTETHER_SIGNUP_WHITELIST_DOMAIN_0=example.com
DUMPTETHER_SIGNUP_INVITE_CODE_0=replace-with-production-invite-code
DUMPTETHER_ENABLE_DEVELOPMENT_LOGIN=false
DUMPTETHER_ENABLE_LOCAL_DESKTOP_LOGIN=false
DUMPTETHER_AUTH_SESSION_DAYS=30
DUMPTETHER_AUTH_SESSION_CLEANUP_DAYS=90
DUMPTETHER_AUTH_SESSION_CLEANUP_INTERVAL_HOURS=24
DUMPTETHER_ARCHIVE_RETENTION_DAYS=30
DUMPTETHER_CORS_ALLOWED_ORIGIN_0=https://dumptether.example.com
DUMPTETHER_EMAIL_CONFIRMATION_ENABLED=false
DUMPTETHER_EMAIL_CONFIRMATION_PUBLIC_BASE_URL=https://dumptether.example.com
DUMPTETHER_EMAIL_FROM=noreply@dumptether.example.com
DUMPTETHER_EMAIL_FROM_NAME=DumpTether
DUMPTETHER_EMAIL_PROVIDER=None
DUMPTETHER_EMAIL_SMTP_HOST=smtp-relay.brevo.com
DUMPTETHER_EMAIL_SMTP_PORT=587
DUMPTETHER_EMAIL_SMTP_USE_AUTHENTICATION=true
DUMPTETHER_EMAIL_SMTP_ENABLE_SSL=true
DUMPTETHER_EMAIL_SMTP_USERNAME=replace-with-production-secret
DUMPTETHER_EMAIL_SMTP_PASSWORD=replace-with-production-secret
DUMPTETHER_EMAIL_BREVO_API_KEY=replace-with-production-secret
DUMPTETHER_EMAIL_MFA_ENABLED=false
DUMPTETHER_OAUTH_MICROSOFT_ENABLED=false
DUMPTETHER_OAUTH_MICROSOFT_CLIENT_ID=replace-with-production-secret
DUMPTETHER_OAUTH_MICROSOFT_CLIENT_SECRET=replace-with-production-secret
DUMPTETHER_OAUTH_MICROSOFT_TENANT_ID=common
DUMPTETHER_MAX_ACTIVE_TASKS_PER_WORKSPACE=1000
DUMPTETHER_MAX_TOTAL_TASKS_PER_WORKSPACE=5000
DUMPTETHER_DOMAIN=dumptether.example.com
