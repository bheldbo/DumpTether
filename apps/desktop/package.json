{
  "name": "@dumptether/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:sidecar:dev && tauri dev",
    "build": "npm run build:desktop",
    "build:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "build:sidecar:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1 -SelfContained 0",
    "build:desktop": "npm run build:sidecar && tauri build",
    "build:desktop:msi": "npm run build:sidecar && tauri build --bundles msi"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
