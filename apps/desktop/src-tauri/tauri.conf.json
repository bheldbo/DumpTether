{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DumpTether",
  "version": "0.1.0",
  "identifier": "net.heldbo.dumptether",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DumpTether",
        "label": "main",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "bheldbo",
    "externalBin": ["binaries/dumptether-api"],
    "icon": ["icons/icon.ico"]
  }
}
