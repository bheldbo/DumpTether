{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default DumpTether desktop capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/dumptether-api",
          "sidecar": true,
          "args": [
            "--environment=Desktop"
          ]
        }
      ]
    }
  ]
}
