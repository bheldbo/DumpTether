# Optional. Vite proxies /api to the local API by default during dev.
# Set this when the frontend should call a specific API origin directly.
VITE_API_BASE_URL=http://localhost:55868

# Optional. Pre-fills the desktop/cloud sync dialog with your hosted API.
# Users can still override the value from the app.
VITE_DEFAULT_CLOUD_API_BASE_URL=https://dump.example.com
