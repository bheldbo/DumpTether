# Copy to .env for local Docker Compose use.
# These values match the Visual Studio launch profile and are safe development defaults.
# Put comments on their own lines. Do not append comments after values.

POSTGRES_DB=dumptether
POSTGRES_USER=dumptether
POSTGRES_PASSWORD=dumptether_dev_password

DUMPTETHER_API_PORT=55868
DUMPTETHER_API_IMAGE=dumptether-api:local
DUMPTETHER_DATABASE_PROVIDER=Postgres
DUMPTETHER_SQLITE_PATH=
DUMPTETHER_APPLY_MIGRATIONS_ON_STARTUP=false
DUMPTETHER_REQUIRE_AUTHENTICATION=true
DUMPTETHER_ALLOW_GUEST_SESSIONS=true
DUMPTETHER_ENABLE_DEVELOPMENT_LOGIN=true
DUMPTETHER_DEVELOPMENT_EMAIL=dev@dumptether.local
DUMPTETHER_DEVELOPMENT_PASSWORD=dumptether-dev-password
DUMPTETHER_DEVELOPMENT_DISPLAY_NAME=Dev User
DUMPTETHER_AUTH_SESSION_DAYS=30
DUMPTETHER_AUTH_SESSION_CLEANUP_DAYS=90
DUMPTETHER_AUTH_SESSION_CLEANUP_INTERVAL_HOURS=24
DUMPTETHER_ARCHIVE_RETENTION_DAYS=30
DUMPTETHER_CORS_ALLOWED_ORIGIN_0=http://localhost:5173
DUMPTETHER_EMAIL_CONFIRMATION_ENABLED=false
DUMPTETHER_EMAIL_CONFIRMATION_PUBLIC_BASE_URL=http://localhost:55868
DUMPTETHER_EMAIL_FROM=noreply@localhost
DUMPTETHER_EMAIL_FROM_NAME=DumpTether
DUMPTETHER_EMAIL_SMTP_ENABLED=false
DUMPTETHER_EMAIL_SMTP_HOST=smtp-relay.brevo.com
DUMPTETHER_EMAIL_SMTP_PORT=587
DUMPTETHER_EMAIL_SMTP_USERNAME=replace-with-local-secret
DUMPTETHER_EMAIL_SMTP_PASSWORD=replace-with-local-secret
DUMPTETHER_EMAIL_BREVO_API_ENABLED=false
DUMPTETHER_EMAIL_BREVO_API_KEY=replace-with-local-secret
DUMPTETHER_EMAIL_MFA_ENABLED=false
DUMPTETHER_OAUTH_GOOGLE_ENABLED=false
DUMPTETHER_OAUTH_GOOGLE_CLIENT_ID=replace-with-local-secret
DUMPTETHER_OAUTH_GOOGLE_CLIENT_SECRET=replace-with-local-secret
DUMPTETHER_OAUTH_MICROSOFT_ENABLED=false
DUMPTETHER_OAUTH_MICROSOFT_CLIENT_ID=replace-with-local-secret
DUMPTETHER_OAUTH_MICROSOFT_CLIENT_SECRET=replace-with-local-secret
DUMPTETHER_OAUTH_FACEBOOK_ENABLED=false
DUMPTETHER_OAUTH_FACEBOOK_CLIENT_ID=replace-with-local-secret
DUMPTETHER_OAUTH_FACEBOOK_CLIENT_SECRET=replace-with-local-secret
DUMPTETHER_MAX_ACTIVE_TASKS_PER_WORKSPACE=1000
DUMPTETHER_MAX_TOTAL_TASKS_PER_WORKSPACE=5000
ASPNETCORE_ENVIRONMENT=Development
