{
  "ConnectionStrings": {
    "DumpTether": "Host=localhost;Port=5432;Database=dumptether;Username=dumptether;Password=change-me"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Auth": {
    "RequireAuthentication": true,
    "EnableDevelopmentLogin": false,
    "DevelopmentEmail": "dev@dumptether.local",
    "DevelopmentPassword": "replace-only-for-local-development",
    "DevelopmentDisplayName": "Dev User",
    "CookieName": "DumpTether.Session",
    "CookieSecurePolicy": "Always",
    "SigningKey": "replace-via-secret-store-if-token-signing-is-enabled",
    "SessionDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://dumptether.example.com"
    ]
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "ForwardedHeaders": "XForwardedFor,XForwardedProto"
  },
  "AllowedHosts": "dumptether.example.com"
}
