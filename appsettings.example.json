{
  "ConnectionStrings": {
    "DumpTether": "Host=localhost;Port=5432;Database=dumptether;Username=dumptether;Password=change-me"
  },
  "Database": {
    "Provider": "Postgres",
    "ApplyMigrationsOnStartup": false,
    "Sqlite": {
      "Path": ""
    }
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Auth": {
    "RequireAuthentication": true,
    "AllowGuestSessions": true,
    "SignupMode": "InviteOnly",
    "SignupWhitelistEmails": [
      "owner@example.com"
    ],
    "SignupWhitelistDomains": [
      "example.com"
    ],
    "SignupInviteCodes": [
      "replace-via-environment"
    ],
    "EnableDevelopmentLogin": false,
    "EnableLocalDesktopLogin": false,
    "DevelopmentEmail": "dev@dumptether.local",
    "DevelopmentPassword": "replace-only-for-local-development",
    "DevelopmentDisplayName": "Dev User",
    "CookieName": "DumpTether.Session",
    "CookieSecurePolicy": "Always",
    "SigningKey": "replace-via-secret-store-if-token-signing-is-enabled",
    "SessionDays": 30,
    "SessionCleanupDays": 90,
    "SessionCleanupIntervalHours": 24
  },
  "Archive": {
    "RetentionDays": 30
  },
  "Email": {
    "Provider": "None",
    "FromEmail": "noreply@dumptether.example.com",
    "FromName": "DumpTether",
    "Smtp": {
      "Host": "smtp-relay.brevo.com",
      "Port": 587,
      "Username": "replace-via-environment",
      "Password": "replace-via-environment",
      "UseAuthentication": true,
      "EnableSsl": true
    },
    "BrevoApi": {
      "ApiKey": "replace-via-environment"
    }
  },
  "EmailConfirmation": {
    "Enabled": false,
    "TokenHours": 24,
    "PublicBaseUrl": "https://dumptether.example.com",
    "ConfirmPath": "/api/auth/confirm-email"
  },
  "Mfa": {
    "Email": {
      "Enabled": false,
      "SuspectLoginOnly": true,
      "CodeMinutes": 10
    }
  },
  "OAuth": {
    "Microsoft": {
      "Enabled": false,
      "ClientId": "replace-via-environment",
      "ClientSecret": "replace-via-environment",
      "TenantId": "common"
    }
  },
  "Legal": {
    "RequireAcceptance": true,
    "TermsVersion": "2026-08-06",
    "PrivacyNoticeVersion": "2026-08-06",
    "OperatorName": "replace-with-the-legal-service-operator",
    "PrivacyContactEmail": "privacy@example.com"
  },
  "Usage": {
    "MaxActiveTasksPerWorkspace": 1000,
    "MaxTotalTasksPerWorkspace": 5000
  },
  "Cors": {
    "AllowedOrigins": [
      "https://dumptether.example.com",
      "http://tauri.localhost"
    ]
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  },
  "AllowedHosts": "dumptether.example.com"
}
