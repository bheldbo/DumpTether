{
  "Database": {
    "Provider": "Postgres",
    "ApplyMigrationsOnStartup": true
  },
  "Auth": {
    "RequireAuthentication": true,
    "AllowGuestSessions": true,
    "EnableDevelopmentLogin": true
  },
  "EmailConfirmation": {
    "Enabled": false,
    "PublicBaseUrl": "http://localhost:55868"
  },
  "Email": {
    "Smtp": {
      "Enabled": false
    },
    "BrevoApi": {
      "Enabled": false
    }
  },
  "Mfa": {
    "Email": {
      "Enabled": false
    }
  },
  "OAuth": {
    "Google": {
      "Enabled": false
    },
    "Microsoft": {
      "Enabled": false
    },
    "Facebook": {
      "Enabled": false
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://tauri.localhost"
    ]
  }
}
