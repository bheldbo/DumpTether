{
  "AllowedHosts": "dumptether.example.com",
  "Database": {
    "Provider": "Postgres",
    "ApplyMigrationsOnStartup": false
  },
  "Auth": {
    "RequireAuthentication": true,
    "AllowGuestSessions": false,
    "EnableDevelopmentLogin": false,
    "SessionDays": 30,
    "SessionCleanupDays": 90,
    "SessionCleanupIntervalHours": 24
  },
  "Archive": {
    "RetentionDays": 30
  },
  "Email": {
    "FromEmail": "",
    "FromName": "DumpTether",
    "Smtp": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": ""
    },
    "BrevoApi": {
      "Enabled": false,
      "ApiKey": ""
    }
  },
  "EmailConfirmation": {
    "Enabled": false,
    "TokenHours": 24,
    "PublicBaseUrl": "https://dumptether.example.com",
    "ConfirmPath": "/api/auth/confirm-email"
  },
  "Mfa": {
    "Email": {
      "Enabled": false,
      "SuspectLoginOnly": true,
      "CodeMinutes": 10
    }
  },
  "OAuth": {
    "Google": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": "",
      "Authority": "https://accounts.google.com"
    },
    "Microsoft": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": "",
      "Authority": "https://login.microsoftonline.com/common/v2.0"
    },
    "Facebook": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": "",
      "Authority": "https://www.facebook.com"
    }
  },
  "Usage": {
    "MaxActiveTasksPerWorkspace": 1000,
    "MaxTotalTasksPerWorkspace": 5000
  },
  "Cors": {
    "AllowedOrigins": [
      "https://dumptether.example.com"
    ]
  }
}
